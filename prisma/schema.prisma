// Prisma schema for Aureon Capital AI
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String            @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String            @default("member")
  handle        String?
  bio           String?
  location      String?
  verified      Boolean           @default(false)
  badge         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  accounts      Account[]
  sessions      Session[]
  watchlists    Watchlist[]
  tradeIdeas    TradeIdea[]
  inquiries     InvestorInquiry[]
  posts         Post[]
  comments      Comment[]
  postVotes     PostVote[]
  notifications Notification[]
  aiRequests    AiRequest[]
  events        Event[]
  eventTickets  EventTicket[]
  preferences   UserPreferences?
  verifications VerificationSubmission[]   @relation("submitter")
  reviewed      VerificationSubmission[]   @relation("reviewer")
  articleComments ArticleComment[]
  autoTradeConfig AutoTradeConfig?
  tradeOrders   TradeOrder[]
}

// A market-moving news item picked up from a source (X, Truth Social, a news
// API, or a manual/AI push) and classified into a tradeable signal.
model NewsSignal {
  id         String   @id @default(cuid())
  source     String // "x" | "truthsocial" | "news" | "manual"
  author     String? // e.g. "@realDonaldTrump"
  headline   String
  body       String?
  url        String?
  instrument String? // e.g. "EURUSD" | "XAUUSD" | "BTCUSD"
  direction  String? // "buy" | "sell" | "neutral"
  sentiment  String? // "bullish" | "bearish" | "neutral"
  impact     String   @default("medium") // "high" | "medium" | "low"
  confidence Int      @default(50) // 0-100
  createdAt  DateTime @default(now())
  orders     TradeOrder[]

  @@index([createdAt])
}

// Per-user automated-trading guardrails. `enabled` doubles as the master
// kill-switch. Trades only fire when a signal clears every threshold here.
model AutoTradeConfig {
  id            String   @id @default(cuid())
  userId        String   @unique
  enabled       Boolean  @default(false)
  maxLot        Float    @default(0.1)
  instruments   String? // comma-separated allowlist; empty = all
  minConfidence Int      @default(70)
  minImpact     String   @default("high") // only act on >= this impact
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// An order produced by the auto-trade engine from a signal. Until an MT5
// bridge is connected these are "simulated"; the same records become live
// orders once execution is wired.
model TradeOrder {
  id         String      @id @default(cuid())
  userId     String
  signalId   String?
  instrument String
  direction  String // "buy" | "sell"
  lot        Float
  status     String      @default("simulated") // simulated | pending | filled | rejected | skipped
  reason     String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal     NewsSignal? @relation(fields: [signalId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model ArticleComment {
  id          String   @id @default(cuid())
  articleSlug String
  userId      String
  body        String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleSlug, createdAt])
}

model VerificationSubmission {
  id           String    @id @default(cuid())
  userId       String
  type         String // "Trading Track Record" | "Broker Statements" | "MyFxBook" | ...
  detail       String? // link or note
  status       String    @default("pending") // pending | approved | rejected
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation("submitter", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?     @relation("reviewer", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
}

model UserPreferences {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id          String        @id @default(cuid())
  organizerId String
  title       String
  description String?
  category    String        @default("Webinar")
  location    String?
  startsAt    DateTime
  price       String        @default("Free")
  capacity    Int?
  createdAt   DateTime      @default(now())
  organizer   User          @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  tickets     EventTicket[]

  @@index([startsAt])
  @@index([organizerId])
}

model EventTicket {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model AiRequest {
  id           String   @id @default(cuid())
  userId       String
  businessName String
  website      String?
  email        String
  businessSize String?
  industry     String?
  problem      String?
  budget       String?
  timeline     String?
  status       String   @default("new")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "comment" | "vote" | "system"
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Post {
  id           String     @id @default(cuid())
  userId       String
  communityKey String // "forex" | "crypto" | "stocks" | ...
  title        String
  body         String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments     Comment[]
  votes        PostVote[]

  @@index([communityKey, createdAt])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostVote {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model TradeIdea {
  id         String   @id @default(cuid())
  userId     String
  symbol     String
  side       String // "buy" | "sell"
  entry      String?
  target     String?
  stop       String?
  note       String?
  confidence Int      @default(3)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InvestorInquiry {
  id         String   @id @default(cuid())
  userId     String
  fullName   String
  amount     String?
  currency   String   @default("USD")
  goal       String?
  risk       String?
  horizon    String?
  markets    String?
  comments   String?
  status     String   @default("new")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  topics      String? // comma-separated
  frequency   String   @default("Weekly")
  confirmedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Watchlist {
  id        String          @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  symbol      String
  createdAt   DateTime  @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
  @@index([watchlistId])
}

// Standard Auth.js models — present so OAuth providers can be added later
// without a migration. Credentials login uses `User.passwordHash` + JWT
// sessions, so these stay empty for now.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
