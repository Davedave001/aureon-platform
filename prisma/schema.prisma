// Prisma schema for Aureon Capital AI
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String            @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String            @default("member")
  handle        String?
  bio           String?
  location      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  accounts      Account[]
  sessions      Session[]
  watchlists    Watchlist[]
  tradeIdeas    TradeIdea[]
  inquiries     InvestorInquiry[]
  posts         Post[]
  comments      Comment[]
  postVotes     PostVote[]
}

model Post {
  id           String     @id @default(cuid())
  userId       String
  communityKey String // "forex" | "crypto" | "stocks" | ...
  title        String
  body         String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments     Comment[]
  votes        PostVote[]

  @@index([communityKey, createdAt])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostVote {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model TradeIdea {
  id         String   @id @default(cuid())
  userId     String
  symbol     String
  side       String // "buy" | "sell"
  entry      String?
  target     String?
  stop       String?
  note       String?
  confidence Int      @default(3)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InvestorInquiry {
  id         String   @id @default(cuid())
  userId     String
  fullName   String
  amount     String?
  currency   String   @default("USD")
  goal       String?
  risk       String?
  horizon    String?
  markets    String?
  comments   String?
  status     String   @default("new")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  topics      String? // comma-separated
  frequency   String   @default("Weekly")
  confirmedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Watchlist {
  id        String          @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  symbol      String
  createdAt   DateTime  @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
  @@index([watchlistId])
}

// Standard Auth.js models — present so OAuth providers can be added later
// without a migration. Credentials login uses `User.passwordHash` + JWT
// sessions, so these stay empty for now.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
